<launch>
  <!-- Camera: "auto" = first external (USB) camera found; or set e.g. /dev/video2 -->
  <arg name="camera_device" default="$(optenv CAMERA_DEVICE auto)" />

  <!-- Publish the camera feed on /camera/image_raw/compressed -->
  <node name="camera" pkg="ros1_apriltag" type="camera_node.py" output="screen" respawn="true" respawn_delay="2">
    <param name="device" value="$(arg camera_device)" />
    <param name="width" value="1280" />
    <param name="height" value="720" />
    <param name="fps" value="30" />
    <param name="jpeg_quality" value="75" />
    <param name="frame_id" value="camera_optical_frame" />
  </node>

  <!-- rosbridge websocket for external (non-ROS) clients -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="9090" />
    <arg name="address" value="0.0.0.0" />
  </include>

  <!-- Launch web_video_server to stream detection video directly to web browser -->
  <node name="web_video_server" pkg="web_video_server" type="web_video_server" output="screen">
    <param name="port" value="8080" />
    <param name="address" value="0.0.0.0" />
  </node>

  <!-- Launch AprilTag detection node -->
  <node name="apriltag_detector" pkg="ros1_apriltag" type="apriltag_node.py" output="screen">
    <param name="tag_family" value="tag36h11" />
    <param name="tag_size" value="0.10" />
    <param name="camera_frame" value="camera_optical_frame" />
    <param name="publish_tf" value="true" />
  </node>
</launch>
