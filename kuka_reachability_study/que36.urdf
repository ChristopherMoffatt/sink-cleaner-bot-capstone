        <box size="0.105 0.1 0.1"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="rear_laser">
    <turnGravityOff>true</turnGravityOff>
    <sensor name="rear_laser" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>50</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-2.35619</min_angle>
            <max_angle>2.35619</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_laser.so" name="gazebo_ros_laser">
        <topicName>rear/scan</topicName>
        <frameName>rear_laser</frameName>
        <robotNamespace>/</robotNamespace>
      </plugin>
    </sensor>
  </gazebo>
  <joint name="rear_laser_joint" type="fixed">
    <!-- This offset is from the base of the bracket to the LIDAR's focal point. -->
    <origin rpy="0 0 3.141592653589793" xyz="-0.3999 0 0.2337"/>
    <parent link="chassis_link"/>
    <child link="rear_laser"/>
  </joint>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <!-- UM7 IMU Link -->
  <link name="um7_link">
  </link>
  <joint name="um7_joint" type="fixed">
    <parent link="base_link"/>
    <child link="um7_link"/>
    <origin rpy="0.0 0 0.0" xyz="-0.020 -0.362 0.135"/>
  </joint>
  <!-- Sensor Frame Mesh Link -->
  <link name="sensor_frame">
    <visual>
      <geometry>
        <mesh filename="package://que36_description/meshes/que36_tower.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://que36_description/meshes/que36_tower.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="sensor_frame_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_frame"/>
    <origin rpy="0.0 0 0.0" xyz="0.0 0.0 0.0"/>
  </joint>
  <!-- Extra collision space around e-stop buttons -->
  <link name="left_button">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.2"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_button_joint" type="fixed">
    <parent link="mid_mount"/>
    <child link="left_button"/>
    <origin rpy="0 0 0" xyz="-0.21 -0.32 0.5"/>
  </joint>
  <link name="right_button">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.15 0.15 0.2"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_button_joint" type="fixed">
    <parent link="mid_mount"/>
    <child link="right_button"/>
    <origin rpy="0 0 0" xyz="-0.21 0.32 0.5"/>
  </joint>
  <!-- Extra collision space behind Ewellix for cables -->
  <link name="cable_gap">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.03 0.15 0.19"/>
      </geometry>
    </collision>
  </link>
  <joint name="cable_gap_joint" type="fixed">
    <parent link="mid_mount"/>
    <child link="cable_gap"/>
    <origin rpy="0 0 0" xyz="0.14 0 0.3"/>
  </joint>
  <!-- Add the ewellix mounting flange -->
  <link name="ewellix_mount_flange_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.015"/>
      </geometry>
      <material name="grey"/>
      <origin rpy="0 0 0" xyz="0 0 0.0075"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.015"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.0075"/>
    </collision>
  </link>
  <joint name="ewellix_mount_flange_joint" type="fixed">
    <parent link="mid_mount"/>
    <child link="ewellix_mount_flange_link"/>
    <origin rpy="0 0 0" xyz="0.252 0.0 0.0"/>
  </joint>
  <!-- Add the Ewellix lift column xacro -->
  <!-- - - - - - - - - - - - - - EWELLIX LIFT - - - - - - - - - - - - - -->
  <!-- Lift base link -->
  <link name="ewellix_lift_base_link">
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ewellix_tlt/meshes/ewellix_lift_base_500mm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0.000 0.000 0.188"/>
      <geometry>
        <box size="0.163 0.163 0.376"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-1" ixy="0" ixz="0" iyy="1e-1" iyz="0" izz="1e-1"/>
    </inertial>
  </link>
  <!-- Lift base link joint -->
  <joint name="ewellix_lift_base_joint" type="fixed">
    <origin rpy="0 0 1.5708" xyz="0 0 0.015"/>
    <parent link="ewellix_mount_flange_link"/>
    <child link="ewellix_lift_base_link"/>
  </joint>
  <!-- Lift top link -->
  <link name="ewellix_lift_top_link">
    <visual>
      <origin rpy="0 0 -1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ewellix_tlt/meshes/ewellix_lift_top_500mm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 -1.5707963267948966" xyz="0.0 0 -0.3515"/>
      <geometry>
        <!-- <mesh filename="package://ewellix_tlt/meshes/ewellix_lift_top_500mm.stl" scale="0.001 0.001 0.001"/> -->
        <box size="0.146 0.146 0.703"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.2e-1" ixy="0" ixz="0" iyy="0.2e-1" iyz="0" izz="0.2e-1"/>
    </inertial>
  </link>
  <!-- Lift top link joint -->
  <joint name="ewellix_lift_top_joint" type="prismatic">
    <parent link="ewellix_lift_base_link"/>
    <child link="ewellix_lift_top_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.52"/>
    <limit effort="100000" lower="0.0" upper="0.5" velocity="0.088"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!--
        PositionJointInterface
        VelocityJointInterface
        EffortJointInterface
    -->
  <gazebo reference="ewellix_lift_top_joint">
    <!-- Needed for ODE to output external wrenches on joints -->
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <transmission name="ewellix_lift_top_joint_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="ewellix_lift_top_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="ewellix_lift_top_joint_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </actuator>
  </transmission>
  <gazebo reference="ewellix_lift_base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="ewellix_lift_top_link">
    <material>Gazebo/Grey</material>
  </gazebo>
